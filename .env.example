# Fine-grained or classic GitHub PAT. Never commit the real value.
GITHUB_TOKEN=github_pat_replace_me

# Optional. Defaults to https://api.github.com (set for GitHub Enterprise Server).
GITHUB_API_URL=https://api.github.com

# stdio (default) or http
GITHUB_MANAGER_TRANSPORT=stdio

# HTTP mode only
PORT=3000
HOST=127.0.0.1

# Optional shared secret protecting the MCP HTTP endpoint.
# If set, clients must send: Authorization: Bearer <value>
MCP_BEARER_TOKEN=replace_with_a_long_random_secret
